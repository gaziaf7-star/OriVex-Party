            title: Row(
              mainAxisSize: MainAxisSize.min,
              children: [
                Icon(Icons.videocam_rounded,
                    color: ColorManager.buttonTextColor, size: 20.sp),
                8.wBox,
                TextWidget(
                  ar ? 'ابدأ بثك الآن' : 'Go live now',
